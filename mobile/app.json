{
  "expo": {
    "name": "WinkBooth",
    "slug": "winkbooth",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "winkbooth",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bhumikagaba.winkbooth",
      "infoPlist": {
        "NSCameraUsageDescription": "WinkBooth uses your camera to capture photo strips locally on your device.",
        "NSMicrophoneUsageDescription": "WinkBooth uses the microphone only when recording boomerang clips.",
        "NSPhotoLibraryAddUsageDescription": "WinkBooth saves exports to your photo library when you choose to save them."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.bhumikagaba.winkbooth",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-sharing",
      "expo-secure-store",
      "expo-audio",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d0b52a43-8415-4d70-8df9-994f0518d7d8"
      }
    },
    "owner": "bhumika23"
  }
}
